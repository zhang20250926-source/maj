@import "table-refinement.wxss";
.page { min-height: 100vh; padding: 22rpx 18rpx calc(150rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 50% 15%, #fbf5e7, #e6dac2 62%, #d8c7a9); }
.room-header { height: 74rpx; display: flex; align-items: center; gap: 20rpx; padding: 0 8rpx 18rpx; }
.brand { display: flex; align-items: center; color: #173f2e; font-weight: 700; font-size: 30rpx; letter-spacing: 2rpx; }.brand-mark { display: grid; place-items: center; width: 42rpx; height: 42rpx; margin-right: 6rpx; border-radius: 9rpx; background: #bd3b2e; color: #fff7e4; font-size: 27rpx; letter-spacing: 0; }.room-name { flex: 1; font-size: 24rpx; color: #2b3a2f; }.room-id { color: #8c9088; font-weight: 400; }.share { margin: 0; padding: 0 19rpx; line-height: 56rpx; border-radius: 10rpx; color: #315744; background: #faf4e7; font-size: 22rpx; }
.table-shell { padding: 10rpx; border-radius: 31rpx; background: linear-gradient(140deg, #e3c36c, #a87836); box-shadow: 0 16rpx 30rpx rgba(64, 49, 23, .2); }.table-felt { position: relative; height: 790rpx; overflow: hidden; border: 3rpx solid #f0d67b; border-radius: 23rpx; background: repeating-linear-gradient(90deg, rgba(255,255,255,.018) 0 1rpx, transparent 1rpx 8rpx), radial-gradient(ellipse at 50% 47%, #11745a, #075241 70%, #063b30); }.felt-title { position: absolute; top: 22rpx; left: 50%; transform: translateX(-50%); color: rgba(245,219,137,.55); font-size: 20rpx; letter-spacing: 9rpx; white-space: nowrap; }
.player { position: absolute; color: #f8f0db; }.player-meta { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; text-shadow: 0 2rpx 2rpx #014333; }.player-meta view { display: flex; flex-direction: column; }.score { color: #c7dacd; font-size: 17rpx; }.wind { display: grid; place-items: center; width: 39rpx; height: 39rpx; border: 1rpx solid #ead47d; border-radius: 8rpx; color: #f9eab0; background: rgba(0, 44, 33, .45); }.wind.active { background: #d3a43e; color: #143b2c; }.mic { margin-left: auto; font-size: 27rpx; color: #c4dbcd; }.muted { opacity: .45; }
.north { top: 57rpx; left: 50%; width: 370rpx; transform: translateX(-50%); }.north-tiles { display: flex; align-items: center; gap: 13rpx; margin-top: 9rpx; }.wall { border: 2rpx solid #f0ddb0; border-radius: 4rpx; background: repeating-linear-gradient(90deg, #d9c49c 0 11rpx, #a98455 11rpx 14rpx); box-shadow: 0 4rpx 5rpx rgba(0, 42, 32, .8); }.wall-horizontal { width: 160rpx; height: 23rpx; }.wall-vertical { width: 23rpx; height: 140rpx; background: repeating-linear-gradient(0deg, #d9c49c 0 11rpx, #a98455 11rpx 14rpx); }.discard-row,.self-discards { display: grid; grid-template-columns: repeat(3, 31rpx); gap: 3rpx; }.discard-row text,.discard-side text,.self-discards text { display: grid; place-items: center; width: 31rpx; height: 38rpx; overflow: hidden; border-radius: 4rpx; background: #f6f1e1; color: #2c4134; font-size: 14rpx; box-shadow: 0 2rpx 2rpx rgba(0, 42, 32, .75); }.side-player { top: 255rpx; width: 112rpx; }.west { left: 14rpx; }.east { right: 14rpx; }.side-body { display: flex; gap: 8rpx; margin-top: 11rpx; }.side-body.right { justify-content: flex-end; }.discard-side { display: grid; grid-template-columns: repeat(2, 31rpx); gap: 3rpx; }
.console { position: absolute; top: 355rpx; left: 50%; width: 204rpx; overflow: hidden; transform: translate(-50%, -50%); border: 3rpx solid #d4b151; border-radius: 18rpx; background: #f8efcf; box-shadow: 0 6rpx 0 #2f5947, 0 10rpx 18rpx rgba(0,0,0,.24); text-align: center; }.console-label,.fixed-chicken { display: flex; justify-content: space-around; padding: 12rpx 5rpx; color: #5e7969; font-size: 15rpx; }.dice { display: flex; justify-content: center; gap: 13rpx; margin: 0; padding: 7rpx 0 2rpx; background: transparent; }.dice text { display: grid; place-items: center; width: 43rpx; height: 43rpx; border: 1rpx solid #c3a362; border-radius: 7rpx; background: #fff8e9; box-shadow: 0 3rpx 0 #b79d64; color: #214738; font-size: 27rpx; }.dice-status { display: block; padding: 7rpx 7rpx 14rpx; color: #829282; font-size: 13rpx; }.fixed-chicken { border-top: 1rpx solid #e3d5ad; background: #e7d7a8; color: #405f50; }
.self { bottom: 18rpx; left: 50%; width: 650rpx; transform: translateX(-50%); }.self-discards { position: absolute; bottom: 135rpx; left: 50%; transform: translateX(-50%); grid-template-columns: repeat(6, 31rpx); }.chicken-zone { display: flex; align-items: end; gap: 8rpx; height: 65rpx; }.zone-label { align-self: center; color: #cad9cd; font-size: 15rpx; }.chicken { display: flex; align-items: end; gap: 4rpx; color: #f2dc8c; font-size: 13rpx; }.chicken.sideways .tile { transform: rotate(90deg); margin: 0 8rpx; }.hand { display: flex; justify-content: center; gap: 3rpx; margin-top: 8rpx; }.tile { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 41rpx; height: 61rpx; overflow: hidden; border: 1rpx solid #a09680; border-radius: 5rpx; background: linear-gradient(135deg, #fffef8, #f4edde 57%, #d8ceb9); box-shadow: inset 1rpx 1rpx 0 #fff, inset -2rpx -2rpx 3rpx rgba(115,94,60,.2), 0 4rpx 0 #8e806a, 0 5rpx 6rpx rgba(0,0,0,.2); font-family: serif; font-size: 31rpx; font-weight: 700; line-height: .77; text-shadow: 0 1rpx 0 #fff; }.tile text:last-child { margin-top: 6rpx; font-size: 13rpx; }.tile.wan { color: #c33129; }.tile.tiao { color: #157b46; }.tile.tong { color: #236697; }.tile.drawn { margin-left: 11rpx; transform: translateY(-9rpx); }.tile.mini { width: 48rpx; height: 65rpx; }
.info-row { display: flex; justify-content: space-between; gap: 13rpx; margin-top: 16rpx; }.random-chicken,.voice,.spectators { border: 1rpx solid rgba(127,109,71,.18); border-radius: 15rpx; background: rgba(250,246,234,.78); box-shadow: 0 7rpx 19rpx rgba(64,51,26,.06); }.random-chicken { display: flex; align-items: center; gap: 10rpx; width: 49%; padding: 14rpx; }.info-label,.random-chicken view:last-child text:last-child { display: block; color: #829081; font-size: 15rpx; }.random-chicken view:last-child text:first-child { display: block; font-size: 23rpx; }.voice { flex: 1; padding: 13rpx; }.voice>text { display: block; font-size: 20rpx; }.voice-on { margin-top: 6rpx; color: #408262; font-size: 15rpx!important; }.voice button { margin: 8rpx 0 0; padding: 0 12rpx; line-height: 42rpx; border-radius: 8rpx; background: #e7d7ac; color: #285c45; font-size: 15rpx; }.spectators { display: flex; justify-content: space-between; margin-top: 13rpx; padding: 14rpx; font-size: 17rpx; }.spectators text:first-child { font-weight: 700; }
.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; align-items: center; padding: 13rpx 20rpx calc(13rpx + env(safe-area-inset-bottom)); background: rgba(251,247,236,.97); box-shadow: 0 -4rpx 16rpx rgba(49,45,26,.13); }.turn { display: flex; align-items: center; gap: 7rpx; width: 190rpx; }.turn view { display: flex; flex-direction: column; color: #2a4e3b; font-size: 18rpx; }.turn view text:last-child { color: #859282; font-size: 13rpx; }.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #dfa83d; box-shadow: 0 0 0 4rpx #f5e6bd; }.actions { display: flex; flex: 1; justify-content: center; gap: 12rpx; }.actions button { width: 75rpx; height: 59rpx; margin: 0; padding: 0; border: 1rpx solid #c9b477; border-radius: 9rpx; background: #f4ead2; color: #2a4c3b; box-shadow: 0 3rpx 0 #bca971; font-size: 27rpx; font-weight: 700; }.actions .hu { border-color: #9c2d25; background: #b93a2e; color: #fff6df; box-shadow: 0 3rpx 0 #7e251e; }.details { width: 68rpx; margin: 0; padding: 0; background: transparent; color: #507160; font-size: 16rpx; }
