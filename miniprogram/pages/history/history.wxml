<view class="page"><view wx:if="{{empty}}" class="empty">还没有已结算的牌局。<text>开一桌，留下第一条战绩吧。</text></view><view wx:for="{{rounds}}" wx:key="id" class="round"><text>第 {{item.number}} 局 · {{item.summary.method}}</text><text>{{item.createdAt}}</text></view><view wx:for="{{transactions}}" wx:key="id" class="round topup"><text>管理员补分 +{{item.amount}}</text><text>{{item.createdAt}}</text></view></view>
