.page{min-height:100vh;padding:36rpx 30rpx;background:radial-gradient(circle at 50% 0,#fbf4e5,#e8dbc1 68%,#d5c19e);color:#193b2d}.hero{position:relative;height:270rpx;overflow:hidden;padding-top:28rpx;text-align:center}.brand{position:relative;z-index:1;color:#194633;font-family:serif;font-size:54rpx;font-weight:700;letter-spacing:7rpx}.brand text{display:inline-grid;place-items:center;width:57rpx;height:57rpx;margin-right:9rpx;border-radius:13rpx;background:#bd3b2e;color:#fff9e7;font-size:38rpx;letter-spacing:0}.tagline{position:relative;z-index:1;display:block;margin-top:16rpx;color:#7e846e;font-size:22rpx;letter-spacing:4rpx}.ink-mountain{position:absolute;bottom:-82rpx;left:50%;width:700rpx;height:230rpx;transform:translateX(-50%);border-radius:50% 50% 0 0;background:linear-gradient(140deg,rgba(33,92,65,.25),rgba(16,70,52,.06));filter:blur(3rpx)}.identity,.create-card{border:1rpx solid rgba(124,105,69,.17);border-radius:22rpx;background:rgba(255,251,240,.78);box-shadow:0 13rpx 30rpx rgba(64,48,21,.1)}.identity{display:flex;align-items:center;gap:15rpx;padding:20rpx}.avatar{display:grid;place-items:center;width:64rpx;height:64rpx;border-radius:50%;background:#2d6249;color:#fff5dc;font-size:27rpx}.identity view:nth-child(2){display:flex;flex:1;flex-direction:column;font-size:26rpx}.identity view:nth-child(2) text:last-child{margin-top:5rpx;color:#7d8a7e;font-size:18rpx}.identity button{margin:0;padding:0 17rpx;background:#e8d8aa;color:#335a46;font-size:19rpx}.create-card{margin-top:22rpx;padding:31rpx}.card-title{display:block;font-family:serif;font-size:35rpx;font-weight:700}.card-copy{display:block;margin-top:11rpx;color:#7c897c;font-size:20rpx;line-height:1.6}.create-card input{height:84rpx;margin-top:25rpx;padding:0 20rpx;border:1rpx solid #d2c4a5;border-radius:12rpx;background:#fffdf5;color:#244533;font-size:25rpx}.create-card button{height:84rpx;margin-top:14rpx;border-radius:12rpx;font-size:26rpx;font-weight:700}.create{background:#1d674b;color:#fff8e5}.join{background:#f1e7cf;color:#305642}.features{display:flex;justify-content:space-between;margin-top:28rpx;text-align:center}.features view{display:flex;flex:1;flex-direction:column;gap:9rpx;color:#56735f;font-size:18rpx}.features view text:first-child{color:#b4772e;font-family:serif;font-size:36rpx;font-weight:700}.notice{margin:28rpx 8rpx;color:#7d8878;font-size:18rpx;line-height:1.7;text-align:center}
